{
  /* Environment Convex functions run in. Generated by `convex codegen --init`,
   * plus a `paths` alias so functions can import the framework-free core. */
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "noUncheckedIndexedAccess": true,

    /* Required by Convex */
    "target": "ESNext",
    "lib": ["ES2023", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true,
    /* TypeScript 6 defaults `types` to []; Convex code reads process.env. */
    "types": ["node"],

    "paths": { "@core/*": ["../core/*"] }
  },
  "include": ["./**/*", "../core/**/*"],
  "exclude": ["./_generated"]
}
