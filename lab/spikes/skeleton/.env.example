# Copy to .env.local (never commit it). Every variable is optional for a
# credential-free build: without them the app renders, /rooms redirects to /setup,
# and no Convex client is created.

# --- Next.js (browser-visible; inlined into client bundles at build time) ---
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Next.js server only ---
CLERK_SECRET_KEY=
CLERK_TELEMETRY_DISABLED=1

# --- Written by `pnpm convex:dev`; selects the dev deployment for the CLI ---
CONVEX_DEPLOYMENT=

# --- Convex deployment env: set with `npx convex env set NAME value`, NOT here ---
# CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL, including https://
# ANTHROPIC_API_KEY         server-side model calls (Convex actions only)
