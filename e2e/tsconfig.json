{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "incremental": false
  },
  "include": [
    "./**/*.ts",
    "../playwright.config.ts"
  ],
  "extends": "../tsconfig.json"
}
