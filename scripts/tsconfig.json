{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "incremental": false,
    "lib": ["ESNext", "DOM"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.mjs"
  ],
  "extends": "../tsconfig.json"
}
